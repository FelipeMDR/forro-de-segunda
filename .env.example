# Copie para .env e preencha com os dados do seu projeto Supabase
# (Dashboard > Project Settings > API). Sem estas variáveis o app
# roda em MODO DEMONSTRAÇÃO (dados locais, sem backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave pública VAPID para notificações push (opcional, Fase 4).
# Gere com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
